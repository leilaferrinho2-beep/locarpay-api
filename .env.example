# Variáveis de ambiente necessárias — copie para .env.local e preencha os valores
# NUNCA comite .env.local ou qualquer arquivo com valores reais

# Firebase Admin SDK (JSON completo da service account)
ILOCARPAY_SERVICE_ACCOUNT=

# Asaas Payment Gateway
ASAAS_API_URL=https://api.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=
ASAAS_BILLING_WEBHOOK_TOKEN=

# Assinafy webhook (configurar URL no dashboard Assinafy com ?token=SECRET)
ASSINAFY_WEBHOOK_SECRET=

# Cron jobs — Vercel envia Authorization: Bearer {CRON_SECRET} automaticamente
CRON_SECRET=

# Admin panel
ADMIN_SECRET=

# SMTP (Titan Email)
TITAN_SMTP_PASSWORD=

# Evolution API (WhatsApp)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
