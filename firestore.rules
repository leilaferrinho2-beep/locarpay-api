rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth()   { return request.auth != null; }
    function myEmail()  { return request.auth.token.email; }
    function isMaster() { return isAuth() && (myEmail() == 'denisfelicio20@gmail.com' || myEmail() == 'contatotransgu@gmail.com'); }

    // Verifica se o usuario autenticado nao foi suspenso/removido
    // Se o documento nao existir OU suspended=true → bloqueia tudo
    function isActiveTenant() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('suspended', false) != true;
    }

    // ── owners ─────────────────────────────────────────────────────────────
    match /owners/{ownerId} {
      allow read:   if isMaster() || (isAuth() && resource.data.get('email','') == myEmail());
      allow write:  if isMaster();
    }

    // ── users ───────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Leitura do proprio doc: permite mesmo que suspended (para o listener detectar)
      // Leitura de outros docs: owner (isAuth) ou master
      allow read:   if isAuth() && (request.auth.uid == userId || isMaster() || isActiveTenant());
      allow create: if isAuth();
      allow update: if isAuth() && (
        resource.data.get('email', '') == myEmail() ||
        isMaster() ||
        // Owner pode atualizar dados dos seus inquilinos
        (resource.data.get('ownerId', '') != '' &&
         exists(/databases/$(database)/documents/owners/$(resource.data.get('ownerId',''))) &&
         get(/databases/$(database)/documents/owners/$(resource.data.get('ownerId',''))).data.get('email','') == myEmail())
      );
      // Qualquer owner autenticado pode suspender/deletar (para o delete funcionar no app)
      allow delete: if isAuth();

      match /savedCards/{cardId} {
        allow read, write: if isAuth() &&
          get(/databases/$(database)/documents/users/$(userId)).data.get('email','') == myEmail()
          || isMaster();
      }
    }

    // ── contracts ────────────────────────────────────────────────────────────
    // Inquilinos suspensos nao conseguem ler contratos
    match /contracts/{contractId} {
      allow read:   if isMaster() || (isAuth() && isActiveTenant());
      allow create: if isAuth();
      allow update: if isAuth() && isActiveTenant();
      allow delete: if isAuth();
    }

    // ── charges ──────────────────────────────────────────────────────────────
    // Inquilinos suspensos nao conseguem ler cobranças
    match /charges/{chargeId} {
      allow read:   if isMaster() || (isAuth() && isActiveTenant());
      allow create: if isAuth() && isActiveTenant();
      allow update: if isAuth() && (
        resource.data.get('tenantEmail', '') == myEmail() ||
        isMaster() ||
        // Owner via ownerId gravado na cobrança
        (resource.data.get('ownerId', '') != '' &&
         exists(/databases/$(database)/documents/owners/$(resource.data.get('ownerId',''))) &&
         get(/databases/$(database)/documents/owners/$(resource.data.get('ownerId',''))).data.get('email','') == myEmail()) ||
        // Cobranças sem ownerId (dados antigos): verifica via tenantId → users.ownerId → owner.email
        (resource.data.get('ownerId', '') == '' &&
         resource.data.get('tenantId', '') != '' &&
         exists(/databases/$(database)/documents/users/$(resource.data.get('tenantId',''))) &&
         get(/databases/$(database)/documents/users/$(resource.data.get('tenantId',''))).data.get('ownerId','') != '' &&
         exists(/databases/$(database)/documents/owners/$(get(/databases/$(database)/documents/users/$(resource.data.get('tenantId',''))).data.get('ownerId',''))) &&
         get(/databases/$(database)/documents/owners/$(get(/databases/$(database)/documents/users/$(resource.data.get('tenantId',''))).data.get('ownerId',''))).data.get('email','') == myEmail())
      );
      allow delete: if isAuth();
    }

    // ── cardVerifications ────────────────────────────────────────────────────
    match /cardVerifications/{verId} {
      allow read:  if isAuth() && isActiveTenant();
      allow write: if false;
    }

    // ── termsAuditLog (LGPD) ────────────────────────────────────────────────
    match /termsAuditLog/{logId} {
      allow read:             if isMaster();
      allow create:           if isAuth();
      allow update, delete:   if false;
    }

    // ── config ───────────────────────────────────────────────────────────────
    match /config/app {
      allow read: if true;  // versão do app é pública — qualquer usuário autenticado ou não
      allow write: if isMaster();
    }
    match /config/{docId} {
      allow read:  if isMaster();
      allow write: if isMaster();
    }

    // ── licenses (legado) ────────────────────────────────────────────────────
    match /licenses/{licId} {
      allow read, write: if isMaster();
    }

    // ── brokers ──────────────────────────────────────────────────────────────
    match /brokers/{brokerId} {
      allow read: if isAuth() && (
        resource.data.get('email','') == myEmail() ||
        isMaster() ||
        // owner da imobiliaria le seus proprios corretores
        (resource.data.get('ownerId','') != '' &&
          exists(/databases/$(database)/documents/owners/$(resource.data.get('ownerId',''))) &&
          get(/databases/$(database)/documents/owners/$(resource.data.get('ownerId',''))).data.get('email','') == myEmail())
      );
      // Corretor pode atualizar seu proprio doc (fcmToken, perfil)
      allow update: if isAuth() && resource.data.get('email','') == myEmail();
      allow create, delete: if isMaster();
    }

    // ── brokerChats (chat imobiliária ↔ corretor) ─────────────────────────────
    match /brokerChats/{chatId} {
      allow read, write: if isAuth();
      match /messages/{msgId} {
        allow read, create: if isAuth();
        allow update, delete: if false;
      }
    }

    // ── leads ─────────────────────────────────────────────────────────────────
    // Corretor só lê leads onde é o brokerEmail; owner/master lê todos do ownerId
    match /leads/{leadId} {
      allow read: if isAuth() && (
        isMaster() ||
        resource.data.get('brokerEmail','') == myEmail() ||
        exists(/databases/$(database)/documents/owners/$(resource.data.get('ownerId',''))) &&
          get(/databases/$(database)/documents/owners/$(resource.data.get('ownerId',''))).data.get('email','') == myEmail()
      );
      allow create: if isAuth();
      allow update: if isAuth() && (
        isMaster() ||
        exists(/databases/$(database)/documents/owners/$(resource.data.get('ownerId',''))) &&
          get(/databases/$(database)/documents/owners/$(resource.data.get('ownerId',''))).data.get('email','') == myEmail()
      );
      allow delete: if isMaster();
    }

    // ── maintenance (chamados) ────────────────────────────────────────────────
    match /maintenance/{chamadoId} {
      allow read:   if isAuth();
      allow create: if isAuth() && isActiveTenant();
      allow update: if isAuth() && (
        isMaster() ||
        exists(/databases/$(database)/documents/owners/$(resource.data.get('ownerId',''))) &&
          get(/databases/$(database)/documents/owners/$(resource.data.get('ownerId',''))).data.get('email','') == myEmail()
      );
      allow delete: if isAuth() && (
        isMaster() ||
        exists(/databases/$(database)/documents/owners/$(resource.data.get('ownerId',''))) &&
          get(/databases/$(database)/documents/owners/$(resource.data.get('ownerId',''))).data.get('email','') == myEmail()
      );

      // Mensagens do chamado (chat inquilino ↔ imobiliária)
      match /messages/{msgId} {
        allow read:   if isAuth();
        allow create: if isAuth();
        allow update, delete: if false;
      }
    }

    // ── default: nega tudo nao declarado ─────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
