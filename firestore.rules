rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth()   { return request.auth != null; }
    function myEmail()  { return request.auth.token.email; }
    function isMaster() { return isAuth() && (myEmail() == 'denisfelicio20@gmail.com' || myEmail() == 'contatotransgu@gmail.com'); }

    function isActiveTenant() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('suspended', false) != true;
    }

    // Verifica se o usuário autenticado é owner do ownerId gravado no documento
    function isOwnerOf(ownerId) {
      return isAuth() && ownerId != '' &&
        exists(/databases/$(database)/documents/owners/$(ownerId)) &&
        get(/databases/$(database)/documents/owners/$(ownerId)).data.get('email','') == myEmail();
    }

    // ── owners ─────────────────────────────────────────────────────────────
    match /owners/{ownerId} {
      allow read:   if isMaster()
                    || (isAuth() && resource.data.get('email','') == myEmail())
                    || (isAuth() && ownerId in request.auth.token.get('ownerIds', []));
      allow write:  if isMaster();
    }

    // ── users ───────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read:   if isAuth() && (
        request.auth.uid == userId ||
        isMaster() ||
        isOwnerOf(resource.data.get('ownerId', ''))  // P0-4
      );
      // P0-3: usuário só pode criar o próprio documento — impede criação com role arbitrário
      allow create: if isAuth() && request.auth.uid == userId;
      allow update: if isAuth() && (
        resource.data.get('email', '') == myEmail() ||
        isMaster() ||
        isOwnerOf(resource.data.get('ownerId', ''))
      );
      allow delete: if isAuth() && (request.auth.uid == userId || isMaster());  // P0-6

      match /savedCards/{cardId} {
        allow read, write: if isAuth() &&
          get(/databases/$(database)/documents/users/$(userId)).data.get('email','') == myEmail()
          || isMaster();
      }
    }

    // ── contracts ────────────────────────────────────────────────────────────
    match /contracts/{contractId} {
      // P0-3: inquilino só lê os seus próprios contratos; owner lê os do seu ownerId
      allow read: if isMaster()
        || isOwnerOf(resource.data.get('ownerId', ''))
        || (isAuth() && resource.data.get('tenantId', '')    == request.auth.uid)
        || (isAuth() && resource.data.get('tenantEmail', '') == myEmail());
      // P1-fix: criação restrita a owner/master — impede tenant de criar contrato arbitrário
      allow create: if isAuth() && (isMaster() || isOwnerOf(request.resource.data.get('ownerId', '')));
      allow update: if isAuth() && (
        isMaster() ||
        isOwnerOf(resource.data.get('ownerId', '')) ||
        // Inquilino só pode marcar campos de leitura, nunca campos financeiros ou de status
        (resource.data.get('tenantId', '') == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['readByTenant', 'seenByTenant', 'readAt']))
      );
      allow delete: if isAuth() && (isMaster() || isOwnerOf(resource.data.get('ownerId', '')));
    }

    // ── charges ──────────────────────────────────────────────────────────────
    match /charges/{chargeId} {
      // P0-3: inquilino só lê cobranças do seu tenantId ou tenantEmail
      allow read: if isMaster()
        || isOwnerOf(resource.data.get('ownerId', ''))
        || (isAuth() && resource.data.get('tenantId', '')    == request.auth.uid)
        || (isAuth() && resource.data.get('tenantEmail', '') == myEmail());
      // P1-fix: criação restrita a owner/master — tenant não cria cobrança falsa
      allow create: if isAuth() && (isMaster() || isOwnerOf(request.resource.data.get('ownerId', '')));
      allow update: if isAuth() && (
        isMaster() ||
        isOwnerOf(resource.data.get('ownerId', '')) ||
        // Cobranças antigas sem ownerId: resolve via tenantId → users.ownerId
        (resource.data.get('ownerId', '') == '' &&
         resource.data.get('tenantId', '') != '' &&
         exists(/databases/$(database)/documents/users/$(resource.data.get('tenantId',''))) &&
         isOwnerOf(get(/databases/$(database)/documents/users/$(resource.data.get('tenantId',''))).data.get('ownerId',''))) ||
        // P0-5: Inquilino só pode atualizar campos de UI — nunca campos financeiros
        (resource.data.get('tenantEmail', '') == myEmail() &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readByTenant', 'seenByTenant', 'readAt']))
      );
      allow delete: if isAuth() && (
        isMaster() ||
        isOwnerOf(resource.data.get('ownerId', '')) ||
        (resource.data.get('ownerId', '') == '' &&
         resource.data.get('tenantId', '') != '' &&
         exists(/databases/$(database)/documents/users/$(resource.data.get('tenantId',''))) &&
         isOwnerOf(get(/databases/$(database)/documents/users/$(resource.data.get('tenantId',''))).data.get('ownerId','')))
      );
    }

    // ── cardVerifications ────────────────────────────────────────────────────
    match /cardVerifications/{verId} {
      allow read:  if isAuth() && isActiveTenant();
      allow write: if false;
    }

    // ── termsAuditLog (LGPD) ────────────────────────────────────────────────
    match /termsAuditLog/{logId} {
      allow read:             if isMaster();
      allow create:           if isAuth();
      allow update, delete:   if false;
    }

    // ── config ───────────────────────────────────────────────────────────────
    match /config/app {
      allow read: if true;
      allow write: if isMaster();
    }
    match /config/{docId} {
      allow read:  if isMaster();
      allow write: if isMaster();
    }

    // ── licenses (legado) ────────────────────────────────────────────────────
    match /licenses/{licId} {
      allow read, write: if isMaster();
    }

    // ── brokers ──────────────────────────────────────────────────────────────
    match /brokers/{brokerId} {
      allow read: if isAuth() && (
        resource.data.get('email','') == myEmail() ||
        isMaster() ||
        isOwnerOf(resource.data.get('ownerId',''))
      );
      allow update: if isAuth() && (
        resource.data.get('email','') == myEmail() ||
        isMaster() ||
        isOwnerOf(resource.data.get('ownerId',''))
      );
      allow create, delete: if isMaster() || isOwnerOf(request.resource.data.get('ownerId',''));
    }

    // ── brokerChats ─────────────────────────────────────────────────────────
    match /brokerChats/{chatId} {
      // P0-3: participante do chat (brokerId ou ownerId no token) ou master
      allow read, write: if isMaster()
        || isOwnerOf(resource.data.get('ownerId', ''))
        || (isAuth() && resource.data.get('brokerId', '') == request.auth.uid);
      match /messages/{msgId} {
        allow read, create: if isMaster()
          || (isAuth() && isOwnerOf(get(/databases/$(database)/documents/brokerChats/$(chatId)).data.get('ownerId','')))
          || (isAuth() && get(/databases/$(database)/documents/brokerChats/$(chatId)).data.get('brokerId','') == request.auth.uid);
        allow update, delete: if false;
      }
    }

    // ── leads ─────────────────────────────────────────────────────────────────
    match /leads/{leadId} {
      allow read: if isAuth() && (
        isMaster() ||
        resource.data.get('brokerEmail','') == myEmail() ||
        isOwnerOf(resource.data.get('ownerId',''))
      );
      allow create: if isAuth();
      allow update: if isAuth() && (
        isMaster() ||
        isOwnerOf(resource.data.get('ownerId',''))
      );
      allow delete: if isMaster() || isOwnerOf(resource.data.get('ownerId',''));
    }

    // ── maintenance (chamados) ────────────────────────────────────────────────
    match /maintenance/{chamadoId} {
      // P1-fix: tenant lê apenas seus chamados; owner lê os do seu ownerId
      allow read: if isMaster()
        || isOwnerOf(resource.data.get('ownerId',''))
        || (isAuth() && isActiveTenant() && resource.data.get('tenantId','') == request.auth.uid);
      allow create: if isAuth() && isActiveTenant();
      allow update: if isAuth() && (isMaster() || isOwnerOf(resource.data.get('ownerId','')));
      allow delete: if isAuth() && (isMaster() || isOwnerOf(resource.data.get('ownerId','')));

      match /messages/{msgId} {
        // P1-fix: leitura e criação restritas aos participantes do chamado pai
        allow read, create: if isMaster()
          || isOwnerOf(get(/databases/$(database)/documents/maintenance/$(chamadoId)).data.get('ownerId',''))
          || (isAuth() && isActiveTenant() &&
              get(/databases/$(database)/documents/maintenance/$(chamadoId)).data.get('tenantId','') == request.auth.uid);
        allow update: if isAuth() && (
          isMaster() ||
          isOwnerOf(resource.data.get('chamadoOwnerId', get(/databases/$(database)/documents/maintenance/$(chamadoId)).data.get('ownerId',''))) ||
          // Tenant pode marcar apenas readByTenant=true em mensagens do owner
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readByTenant','readAt']) &&
           request.resource.data.readByTenant == true)
        );
        allow delete: if false;
      }
    }

    // ── messages (mural de avisos owner→inquilino) ───────────────────────────
    match /messages/{msgId} {
      // P0-3: inquilino lê mensagens do seu ownerId; owner cria/lê as suas
      allow read: if isMaster()
        || isOwnerOf(resource.data.get('ownerId', ''))
        || (isAuth() && resource.data.get('tenantId', '')    == request.auth.uid)
        || (isAuth() && resource.data.get('tenantEmail', '') == myEmail());
      allow create: if isAuth() && (
        isMaster() || isOwnerOf(request.resource.data.get('ownerId', ''))
      );
      // Inquilino pode marcar readByTenant=true nas mensagens do owner
      allow update: if isAuth() && (
        isMaster() ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readByTenant','readAt']) &&
         request.resource.data.readByTenant == true)
      );
      allow delete: if isMaster();
    }

    // ── _rateLimits ───────────────────────────────────────────────────────────
    match /_rateLimits/{docId} {
      allow read, write: if false;
    }

    // ── crash_logs ────────────────────────────────────────────────────────────
    match /crash_logs/{docId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // ── default ───────────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
