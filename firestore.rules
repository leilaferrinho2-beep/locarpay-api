rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth()   { return request.auth != null; }
    function myEmail()  { return request.auth.token.email; }
    function isMaster() { return isAuth() && (myEmail() == 'denisfelicio20@gmail.com' || myEmail() == 'contatotransgu@gmail.com'); }

    function isActiveTenant() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('suspended', false) != true;
    }

    // Verifica se o usuário autenticado é owner do ownerId gravado no documento
    function isOwnerOf(ownerId) {
      return isAuth() && ownerId != '' &&
        exists(/databases/$(database)/documents/owners/$(ownerId)) &&
        get(/databases/$(database)/documents/owners/$(ownerId)).data.get('email','') == myEmail();
    }

    // ── owners ─────────────────────────────────────────────────────────────
    match /owners/{ownerId} {
      allow read:   if isMaster()
                    || (isAuth() && resource.data.get('email','') == myEmail())
                    || (isAuth() && ownerId in request.auth.token.get('ownerIds', []));
      allow write:  if isMaster();
    }

    // ── users ───────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read:   if isAuth() && (request.auth.uid == userId || isMaster() || isActiveTenant());
      allow create: if isAuth();
      allow update: if isAuth() && (
        resource.data.get('email', '') == myEmail() ||
        isMaster() ||
        isOwnerOf(resource.data.get('ownerId', ''))
      );
      allow delete: if isAuth();

      match /savedCards/{cardId} {
        allow read, write: if isAuth() &&
          get(/databases/$(database)/documents/users/$(userId)).data.get('email','') == myEmail()
          || isMaster();
      }
    }

    // ── contracts ────────────────────────────────────────────────────────────
    match /contracts/{contractId} {
      allow read:   if isMaster() || (isAuth() && isActiveTenant());
      allow create: if isAuth();
      allow update: if isAuth() && (
        isMaster() ||
        isActiveTenant() ||
        isOwnerOf(resource.data.get('ownerId', ''))
      );
      allow delete: if isAuth() && (isMaster() || isOwnerOf(resource.data.get('ownerId', '')));
    }

    // ── charges ──────────────────────────────────────────────────────────────
    match /charges/{chargeId} {
      allow read:   if isMaster() || (isAuth() && isActiveTenant());
      allow create: if isAuth();
      allow update: if isAuth() && (
        resource.data.get('tenantEmail', '') == myEmail() ||
        isMaster() ||
        isOwnerOf(resource.data.get('ownerId', '')) ||
        // Cobranças antigas sem ownerId: resolve via tenantId → users.ownerId
        (resource.data.get('ownerId', '') == '' &&
         resource.data.get('tenantId', '') != '' &&
         exists(/databases/$(database)/documents/users/$(resource.data.get('tenantId',''))) &&
         isOwnerOf(get(/databases/$(database)/documents/users/$(resource.data.get('tenantId',''))).data.get('ownerId','')))
      );
      allow delete: if isAuth() && (
        isMaster() ||
        isOwnerOf(resource.data.get('ownerId', '')) ||
        (resource.data.get('ownerId', '') == '' &&
         resource.data.get('tenantId', '') != '' &&
         exists(/databases/$(database)/documents/users/$(resource.data.get('tenantId',''))) &&
         isOwnerOf(get(/databases/$(database)/documents/users/$(resource.data.get('tenantId',''))).data.get('ownerId','')))
      );
    }

    // ── cardVerifications ────────────────────────────────────────────────────
    match /cardVerifications/{verId} {
      allow read:  if isAuth() && isActiveTenant();
      allow write: if false;
    }

    // ── termsAuditLog (LGPD) ────────────────────────────────────────────────
    match /termsAuditLog/{logId} {
      allow read:             if isMaster();
      allow create:           if isAuth();
      allow update, delete:   if false;
    }

    // ── config ───────────────────────────────────────────────────────────────
    match /config/app {
      allow read: if true;
      allow write: if isMaster();
    }
    match /config/{docId} {
      allow read:  if isMaster();
      allow write: if isMaster();
    }

    // ── licenses (legado) ────────────────────────────────────────────────────
    match /licenses/{licId} {
      allow read, write: if isMaster();
    }

    // ── brokers ──────────────────────────────────────────────────────────────
    match /brokers/{brokerId} {
      allow read: if isAuth() && (
        resource.data.get('email','') == myEmail() ||
        isMaster() ||
        isOwnerOf(resource.data.get('ownerId',''))
      );
      allow update: if isAuth() && (
        resource.data.get('email','') == myEmail() ||
        isMaster() ||
        isOwnerOf(resource.data.get('ownerId',''))
      );
      allow create, delete: if isMaster() || isOwnerOf(request.resource.data.get('ownerId',''));
    }

    // ── brokerChats ─────────────────────────────────────────────────────────
    match /brokerChats/{chatId} {
      allow read, write: if isAuth();
      match /messages/{msgId} {
        allow read, create: if isAuth();
        allow update, delete: if false;
      }
    }

    // ── leads ─────────────────────────────────────────────────────────────────
    match /leads/{leadId} {
      allow read: if isAuth() && (
        isMaster() ||
        resource.data.get('brokerEmail','') == myEmail() ||
        isOwnerOf(resource.data.get('ownerId',''))
      );
      allow create: if isAuth();
      allow update: if isAuth() && (
        isMaster() ||
        isOwnerOf(resource.data.get('ownerId',''))
      );
      allow delete: if isMaster() || isOwnerOf(resource.data.get('ownerId',''));
    }

    // ── maintenance (chamados) ────────────────────────────────────────────────
    match /maintenance/{chamadoId} {
      allow read:   if isAuth();
      allow create: if isAuth() && isActiveTenant();
      allow update: if isAuth() && (isMaster() || isOwnerOf(resource.data.get('ownerId','')));
      allow delete: if isAuth() && (isMaster() || isOwnerOf(resource.data.get('ownerId','')));

      match /messages/{msgId} {
        allow read:   if isAuth();
        allow create: if isAuth();
        allow update: if isAuth() && (
          isMaster() ||
          isOwnerOf(resource.data.get('chamadoOwnerId', get(/databases/$(database)/documents/maintenance/$(chamadoId)).data.get('ownerId',''))) ||
          // Tenant pode marcar apenas readByTenant=true em mensagens do owner
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readByTenant','readAt']) &&
           request.resource.data.readByTenant == true)
        );
        allow delete: if false;
      }
    }

    // ── messages (mural de avisos owner→inquilino) ───────────────────────────
    match /messages/{msgId} {
      // Inquilino lê as mensagens do seu contrato; owner escreve
      allow read: if isAuth();
      allow create: if isAuth();
      // Inquilino pode marcar readByTenant=true nas mensagens do owner
      allow update: if isAuth() && (
        isMaster() ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readByTenant','readAt']) &&
         request.resource.data.readByTenant == true)
      );
      allow delete: if isMaster();
    }

    // ── _rateLimits ───────────────────────────────────────────────────────────
    match /_rateLimits/{docId} {
      allow read, write: if false;
    }

    // ── crash_logs ────────────────────────────────────────────────────────────
    match /crash_logs/{docId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // ── default ───────────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
