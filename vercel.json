{
  "cleanUrls": true,
  "rewrites": [
{ "source": "/billing-webhook",   "destination": "/api/locarpay-owner" },
    { "source": "/payment-webhook",   "destination": "/api/locarpay-card" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/", "destination": "/admin/index.html" },
    { "source": "/locarpay/admin", "destination": "/admin/index.html" },
    { "source": "/locarpay/admin/", "destination": "/admin/index.html" },
    { "source": "/broker", "destination": "/broker/index.html" },
    { "source": "/broker/", "destination": "/broker/index.html" },
    { "source": "/superadmin", "destination": "/superadmin/index.html" },
    { "source": "/superadmin/", "destination": "/superadmin/index.html" },
    { "source": "/api/version", "destination": "/version.json" }
  ],
  "headers": [
    {
      "source": "/download/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/locarpay-owner",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/locarpay-card?step=cron-daily",
      "schedule": "0 13 * * *"
    }
  ]
}
