{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/version.json",      "destination": "/api/version" },
    { "source": "/billing-webhook",   "destination": "/api/locarpay-owner" },
    { "source": "/payment-webhook",   "destination": "/api/locarpay-card" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/", "destination": "/admin/index.html" },
    { "source": "/locarpay/admin", "destination": "/admin/index.html" },
    { "source": "/locarpay/admin/", "destination": "/admin/index.html" }
  ],
  "headers": [
    {
      "source": "/download/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/locarpay-owner",
      "schedule": "0 11 * * *"
    }
  ]
}
