{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/billing-webhook",              "destination": "/api/locarpay-owner" },
    { "source": "/payment-webhook",              "destination": "/api/locarpay-card" },
    { "source": "/admin",                        "destination": "/admin/index.html" },
    { "source": "/admin/",                       "destination": "/admin/index.html" },
    { "source": "/locarpay/admin",               "destination": "/admin/index.html" },
    { "source": "/locarpay/admin/",              "destination": "/admin/index.html" },
    { "source": "/broker",                       "destination": "/broker/index.html" },
    { "source": "/broker/",                      "destination": "/broker/index.html" },
    { "source": "/superadmin",                   "destination": "/superadmin/index.html" },
    { "source": "/superadmin/",                  "destination": "/superadmin/index.html" },
    { "source": "/api/version",                  "destination": "/version.json" },
    { "source": "/api/locarpay-reassign-contract","destination": "/api/locarpay-fix-contract" },
    { "source": "/api/locarpay-sync-status",     "destination": "/api/locarpay-card" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options",    "value": "nosniff" },
        { "key": "X-Frame-Options",           "value": "DENY" },
        { "key": "X-XSS-Protection",          "value": "1; mode=block" },
        { "key": "Referrer-Policy",           "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",        "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    },
    {
      "source": "/download/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ],
  "functions": {
    "api/locarpay-broker.js": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/locarpay-owner",           "schedule": "0 11 * * *" },
    { "path": "/api/locarpay-card?step=cron-daily", "schedule": "0 13 * * *" }
  ]
}
